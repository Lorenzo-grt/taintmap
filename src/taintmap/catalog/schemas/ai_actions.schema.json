{
  "$defs": {
    "AiAction": {
      "additionalProperties": false,
      "properties": {
        "actor_gate_inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Actor Gate Inputs",
          "type": "array"
        },
        "category": {
          "const": "carrier.llm_agent",
          "title": "Category",
          "type": "string"
        },
        "credential_inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Credential Inputs",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_reason": {
          "minLength": 1,
          "pattern": "^[^\\n]+$",
          "title": "Evidence Reason",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "mcp_configs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Mcp Configs",
          "type": "array"
        },
        "mcp_configs_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mcp_configs_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^\\n]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Configs Reason"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "prompt_inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Prompt Inputs",
          "type": "array"
        },
        "reads_event": {
          "title": "Reads Event",
          "type": "boolean"
        },
        "reads_event_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reads_event_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^\\n]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reads Event Reason"
        },
        "sandbox_inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Sandbox Inputs",
          "type": "array"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "tool_config_inputs": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "title": "Tool Config Inputs",
          "type": "array"
        },
        "uses": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+$",
          "title": "Uses",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "evidence",
        "evidence_reason",
        "id",
        "uses",
        "description",
        "category",
        "prompt_inputs",
        "tool_config_inputs",
        "credential_inputs",
        "sandbox_inputs",
        "actor_gate_inputs",
        "reads_event"
      ],
      "title": "AiAction",
      "type": "object"
    },
    "Evidence": {
      "description": "How firmly a catalog claim is backed by its source.",
      "enum": [
        "documented",
        "inferred"
      ],
      "title": "Evidence",
      "type": "string"
    }
  },
  "$id": "https://github.com/aakashsiwach/taintmap/schemas/ai_actions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/AiAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "actions"
  ],
  "title": "AiActionsCatalog",
  "type": "object"
}
