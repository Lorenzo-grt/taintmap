{
  "$defs": {
    "Author": {
      "additionalProperties": false,
      "description": "A payload object whose author writes untrusted input, and where its association is.",
      "properties": {
        "author_association": {
          "pattern": "^github\\.event\\.[a-z_.]+$",
          "title": "Author Association",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_reason": {
          "minLength": 1,
          "pattern": "^[^\\n]+$",
          "title": "Evidence Reason",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "evidence",
        "evidence_reason",
        "id",
        "author_association"
      ],
      "title": "Author",
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Author"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_reason": {
          "minLength": 1,
          "pattern": "^[^\\n]+$",
          "title": "Evidence Reason",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z_]+(\\.([A-Za-z0-9_-]+|\\*))+$",
          "title": "Id",
          "type": "string"
        },
        "source_category": {
          "$ref": "#/$defs/SourceCategory"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "triggers": {
          "items": {
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "source_url",
        "evidence",
        "evidence_reason",
        "id",
        "description",
        "source_category",
        "author",
        "triggers"
      ],
      "title": "Context",
      "type": "object"
    },
    "Evidence": {
      "description": "How firmly a catalog claim is backed by its source.",
      "enum": [
        "documented",
        "inferred"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "SourceCategory": {
      "description": "Where untrusted input enters.",
      "enum": [
        "source.untrusted.issue_text",
        "source.untrusted.pr_content",
        "source.untrusted.discussion",
        "source.untrusted.web_content",
        "source.untrusted.email",
        "source.untrusted.chat",
        "source.untrusted.file_upload",
        "source.untrusted.webhook"
      ],
      "title": "SourceCategory",
      "type": "string"
    },
    "Trigger": {
      "additionalProperties": false,
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Author"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "evidence_reason": {
          "minLength": 1,
          "pattern": "^[^\\n]+$",
          "title": "Evidence Reason",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Id",
          "type": "string"
        },
        "source_category": {
          "$ref": "#/$defs/SourceCategory"
        },
        "source_url": {
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_url",
        "evidence",
        "evidence_reason",
        "id",
        "author",
        "description",
        "source_category"
      ],
      "title": "Trigger",
      "type": "object"
    }
  },
  "$id": "https://github.com/aakashsiwach/taintmap/schemas/gha_triggers.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authors": {
      "items": {
        "$ref": "#/$defs/Author"
      },
      "title": "Authors",
      "type": "array"
    },
    "contexts": {
      "items": {
        "$ref": "#/$defs/Context"
      },
      "title": "Contexts",
      "type": "array"
    },
    "triggers": {
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "title": "Triggers",
      "type": "array"
    },
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "version",
    "authors",
    "triggers",
    "contexts"
  ],
  "title": "GhaTriggersCatalog",
  "type": "object"
}
