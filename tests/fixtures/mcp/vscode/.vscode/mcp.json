{
  "inputs": [
    {"type": "promptString", "id": "github_token", "description": "GitHub token", "password": true}
  ],
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_token}"
      }
    },
    "browser": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}
